[tes_controller:vars]
host_key_checking=False
ansible_ssh_private_key_file=test.pem
ansible_ssh_user=ubuntu
KAFKA_CLUSTER_ID=cluster-id
process_roles=broker,controller
listeners_host="PLAINTEXT://:9092,CONTROLLER://:9093"

[test_broker:vars]
host_key_checking=False
ansible_ssh_private_key_file=test.pem
ansible_ssh_user=ubuntu
KAFKA_CLUSTER_ID=cluster-id
process_roles=broker
listeners_host="PLAINTEXT://:9092"
