process.roles=broker,controller
node.id={{ broker_id.broker_id }}
controller.quorum.voters={{ controller_quorum }}
listeners=PLAINTEXT://:9092,CONTROLLER://:9093
inter.broker.listener.name=PLAINTEXT
controller.listener.names=CONTROLLER
listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,SSL:SSL,SASL_PLAINTEXT:SASL_PLAINTEXT,SASL_SSL:SASL_SSL
default.replication.factor=2
zookeeper.session.timeout.ms=10000
inter.broker.protocol.version=3.7
log.message.format.version=3.7
num.partitions=3
min.insync.replicas=1
log.retention.ms=259200000
message.max.bytes=20971520
log.flush.interval.ms=5000
log.roll.hours=24
log.dirs=/data/kafka
auto.create.topics.enable=true
delete.topic.enable=true
replica.fetch.max.bytes=20971520
replica.fetch.response.max.bytes=20971520
max.partition.fetch.bytes=20971520
fetch.max.bytes=20971520
zookeeper.connection.timeout.ms=10000
num.io.threads=8
num.network.threads=8
num.replica.fetchers=8
